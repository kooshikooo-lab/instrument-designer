{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Instrument Designer",
  "version": "0.1.0",
  "identifier": "com.kooshikooo.instrument-designer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Instrument Designer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../backend/**/*",
      "../../woodwind_designer/**/*",
      "../../config/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "shell": {
      "allowlist": [
        {
          "name": "python",
          "cmd": "python",
          "args": ["-m", "uvicorn", "woodwind_designer.engine.design_server:app", "--host", "127.0.0.1", "--port", "8000"],
          "sidecar": false
        }
      ]
    }
  }
}